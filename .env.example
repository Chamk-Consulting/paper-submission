# Copy to .env.local for local dev. Set the same names in Vercel (per environment).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser. Set in Vercel, not in git.
SUPABASE_SECRET_KEY=
# TODO(domain): https://<your-domain> in production; Vercel URL in staging.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# TODO(domain): switch to no-reply@<domain> / events@<domain> after Resend domain verification.
EMAIL_FROM_AUTH="Plenary <onboarding@resend.dev>"
EMAIL_FROM_EVENTS="Plenary <onboarding@resend.dev>"
