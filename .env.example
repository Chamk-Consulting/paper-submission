# Hyper Papers (Plenary) — every environment setting the app reads.
#
# Local: copy this file to .env.local and fill in the blanks.
# Vercel: Project › Settings › Environment Variables — same names. Mark every SECRET as "Sensitive".
# Never commit real secrets, and never paste them into chat or tickets.
#
# Status column: [SET] = already set on Vercel production · [OPTIONAL] = feature stays off without it
#                [NEEDED FOR …] = that feature waits for it.

# ─── Supabase (database, sign-in, files) ────────────────────────────────────────────────────────────────────
# Supabase › Project Settings › API. Public values: safe in the browser (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://wxhtcbqtnugniivkbseu.supabase.co                          # [SET]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_21E4XSxqSa3XLFbkp-cKdw_SUbgXNdk        # [SET]
# SECRET. Supabase › Project Settings › API › Secret keys. Server only.
# Only the two nightly jobs need it (data-export requests, sign-up funnel); everything else works without it.
SUPABASE_SECRET_KEY=                                                                      # [NEEDED FOR nightly jobs]

# ─── Site ───────────────────────────────────────────────────────────────────────────────────────────────────
# Public address used in email links. Production: the live address (later your own domain). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://paper-submission-nessim-teams.vercel.app                      # [SET]
# Support address shown on help pages (SUPPORT_EMAIL wins on the server if both are set).
NEXT_PUBLIC_SUPPORT_EMAIL=                                                                # [OPTIONAL]
SUPPORT_EMAIL=                                                                            # [OPTIONAL]
# Where contact-form messages are delivered.
CONTACT_TO=rabehghazi81@gmail.com                                                         # [SET]

# ─── Email (Resend) ─────────────────────────────────────────────────────────────────────────────────────────
# SECRET. resend.com › API Keys (sending access). The current key was once pasted in chat: create a new one,
# put it here and in Vercel, then delete the old key in Resend.
RESEND_API_KEY=                                                                           # [SET — rotate]
# Senders: must be on a domain verified in Resend.
EMAIL_FROM_AUTH="Plenary <noreply@resend.ghazirabeh.com>"                                 # [SET]
EMAIL_FROM_EVENTS="Plenary <noreply@resend.ghazirabeh.com>"                               # [SET]
NEXT_PUBLIC_NO_REPLY_EMAIL=noreply@resend.ghazirabeh.com                                  # [SET]
# SECRET. Supabase › Authentication › Hooks › Send Email hook › secret (starts with v1,whsec_). Also pasted in chat
# once: regenerate it in Supabase and update it here and in Vercel at the same time.
SEND_EMAIL_HOOK_SECRET=                                                                   # [SET — rotate]

# ─── Signed requests between the app and the database ───────────────────────────────────────────────────────
# SECRET. Any long random string (e.g. `openssl rand -hex 32`). Must equal the database value
# private.app_secrets('signing'). Used for PIN and alias sign-in, sign-up without a code, Folio builds.
PLENARY_SIGNING_SECRET=                                                                   # [SET]

# ─── Scheduled jobs (vercel.json crons) ─────────────────────────────────────────────────────────────────────
# SECRET. Any long random string; Vercel sends it to the cron routes automatically.
CRON_SECRET=                                                                              # [NEEDED FOR nightly jobs]

# ─── Folio (LaTeX editor) ───────────────────────────────────────────────────────────────────────────────────
# Vercel Sandbox snapshot with TeX Live that builds start from. A non-expiring copy is kept in the database
# (folio_settings), so this is only the starting point.
FOLIO_TEX_SNAPSHOT=snap_lSjDKPJlkJVLGQrtWrt61B5D3YXh                                      # [SET]

# ─── Optional features (off until set) ──────────────────────────────────────────────────────────────────────
# Bot check on sign-up and contact forms — Cloudflare › Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                                                           # [OPTIONAL]
TURNSTILE_SECRET_KEY=                                                                     # [OPTIONAL] SECRET
# Online payments for registration and invoices — Stripe › Developers › API keys / Webhooks.
STRIPE_SECRET_KEY=                                                                        # [OPTIONAL] SECRET
STRIPE_WEBHOOK_SECRET=                                                                    # [OPTIONAL] SECRET
# AI help in forms (abstract polish, translation) — console.anthropic.com.
ANTHROPIC_API_KEY=                                                                        # [OPTIONAL] SECRET
ANTHROPIC_MODEL=claude-sonnet-5-5                                                         # [OPTIONAL]
# Similarity check provider for organizers (e.g. iThenticate API).
SIMILARITY_API_URL=                                                                       # [OPTIONAL]
SIMILARITY_API_KEY=                                                                       # [OPTIONAL] SECRET
# IEEE electronic copyright form link shown to authors of accepted papers.
IEEE_ECF_URL=https://ecopyright.ieee.org/                                                 # [OPTIONAL]

# ─── Behaviour switches (leave unset unless you mean it) ────────────────────────────────────────────────────
# Number of boxes on email-code screens. Must match Supabase › Authentication › Email › Email OTP length.
NEXT_PUBLIC_AUTH_CODE_LENGTH=6
# 1 = old sign-up order (password before the email code). Normally unset.
SIGNUP_PASSWORD_FIRST=
# Accounts created after this moment go through the "choose a password" step.
PASSWORD_STEP_SINCE=2026-10-22T20:00:00Z
# 1 = turn on the /dev-preview pages (sample data). Never on production.
PLENARY_PREVIEW=
